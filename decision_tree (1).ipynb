   "source": [
    "from sklearn.tree import DecisionTreeClassifier\n",
    "\n",
    "\n",
    "X = [[1], [2], [3], [5], [6], [8]]\n",
    "y = [0, 0, 0, 1, 1, 1] \n",
    "\n",
    "\n",
    "model = DecisionTreeClassifier(\n",
    "    max_depth=2,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "\n",
    "model.fit(X, y)\n",
    "\n",
    "\n",
    "prediction = model.predict([[100]])\n",
    "\n",
    "print(prediction)"
   ]
  },
